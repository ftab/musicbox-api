{
  "name": "musicbox-api",
  "version": "0.0.0",
  "private": "true",
  "main": "backend/server.js",
  "scripts": {
    "dev:server": "node --watch backend/server.js",
    "dev:client": "vite",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "vite build --emptyOutDir",
    "test:api": "NODE_ENV=test mocha --exit tests/api/*",
    "test:vue": "vitest run",
    "test": "npm run test:api && npm run test:vue",
    "start": "NODE_ENV=production node backend/server.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.4.6",
    "concurrently": "^10.0.3",
    "jsdom": "^29.0.1",
    "mocha": "^11.7.6",
    "supertest": "^7.2.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "vue": "^3.5.40",
    "vue-awesome-paginate": "^1.2.0",
    "vue-router": "^5.1.0"
  },
  "dependencies": {
    "express": "^5.2.1",
    "js-cookie": "^3.0.8",
    "marked": "^18.0.0",
    "mysql2": "^3.11.0",
    "path-to-regexp": "^8.4.2",
    "qs": "^6.15.2",
    "socket.io-client": "^4.8.3",
    "zod": "^4.3.6"
  },
  "overrides": {
    "diff": "^9.0.0",
    "ws": "^8.21.0",
    "serialize-javascript": "^7.0.5"
  }
}
