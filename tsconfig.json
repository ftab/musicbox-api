{
    "compilerOptions": {
        "checkJs": true,
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "jsx": "preserve",
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "baseUrl": ".",
        "paths": {
            "@/*": ["frontend/src/*"]
        }
    },
    "vueCompilerOptions": {
        "target": 3
    },
    "include": ["frontend/src/**/*"]
}
